<div class="news">
  {% if page.latest_posts != blank %}
    {% assign latest_posts_size = site.posts | size %}
    {% assign latest_posts = site.posts %}
    {% if page.latest_posts.limit %}
      {% assign latest_posts_limit = page.latest_posts.limit %}
    {% else %}
      {% assign latest_posts_limit = latest_posts_size %}
    {% endif %}

    <div class="row row-cols-1">
      {% for item in latest_posts limit: latest_posts_limit %}
          {% assign post_url = item.url | relative_url %}
          {% assign is_external = false %}
          {% if item.redirect != blank %}
            {% if item.redirect contains '://' %}
              {% assign post_url = item.redirect %}
              {% assign is_external = true %}
            {% else %}
              {% assign post_url = item.redirect | relative_url %}
            {% endif %}
          {% endif %}

          {% assign excerpt_text = item.description | default: item.excerpt %}
          {% assign excerpt_text = excerpt_text | strip_html | strip_newlines | strip %}

          <div class="col mb-3">
            <a href="{{ post_url }}" {% if is_external %}target="_blank" rel="noopener noreferrer"{% endif %}>
              <div class="card hoverable">
                <div class="card-body">
                  <div class="d-flex justify-content-between align-items-start">
                    <h3 class="card-title mb-1">{{ item.title }}</h3>
                    {% if is_external %}
                      <svg width="1.5rem" height="1.5rem" viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                        <path
                          d="M17 13.5v6H5v-12h6m3-3h6v6m0-6-9 9"
                          class="icon_svg-stroke"
                          stroke="#999"
                          stroke-width="1.5"
                          fill="none"
                          fill-rule="evenodd"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        ></path>
                      </svg>
                    {% endif %}
                  </div>
                  <div class="text-muted" style="font-size: 0.875rem">{{ item.date | date: '%b %d, %Y' }}</div>
                  {% if excerpt_text != blank %}
                    <p class="card-text mt-2 mb-0">{{ excerpt_text | truncate: 180 }}</p>
                  {% endif %}
                </div>
              </div>
            </a>
          </div>
      {% endfor %}
    </div>
  {% else %}
    <p>No posts so far...</p>
  {% endif %}
</div>
